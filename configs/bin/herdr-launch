#!/usr/bin/env fish
# herdr-launch — ghq リポジトリを herdr workspace として定型レイアウトで開く。
# herdr の popup keybind (prefix+ctrl+o) から起動する前提。
#
# モード:
#   open      リポジトリ本体を workspace として開く
#   worktree  worktrunk で新規ブランチの worktree を作って開く (自分の作業用)
#   pr-review worktrunk で PR ブランチの worktree を作り、hunk レビュー + claude /code-review
#
# worktree の作成は worktrunk (wt) に委譲する。作成時のプロジェクト固有
# セットアップ (依存インストール等) は各リポジトリの .config/wt.toml の hook に置く。
# リポジトリルートに実行可能な .herdr-setup.fish があれば、レイアウト構築後に
# HERDR_LAUNCH_WORKSPACE_ID / HERDR_LAUNCH_MODE を渡して実行する。

# 失敗時に popup が即閉じてエラーが読めなくなるのを防ぐ。
function fail_pause
    read -P 'error: press enter to close> '
    exit 1
end

# --- リポジトリ選択 ---
# ghq root は複数 (~/src, ~/.dotfiles) あるため、primary root との結合ではなく
# --full-path でフルパスを直接受け取る。
set -l repo_path (ghq list --full-path | fzf --prompt='repo> ')
test -n "$repo_path"; or exit 0
set -l repo_name (basename $repo_path)

# --- モード選択 ---
set -l mode (printf '%s\n' open worktree pr-review | fzf --prompt='mode> ')
test -n "$mode"; or exit 0

set -l created # workspace 作成系コマンドの JSON レスポンス
set -l base_branch # pr-review でのみ使う。PR の base ブランチ

switch $mode
    case open
        set created (herdr workspace create --cwd $repo_path --label $repo_name --focus)
        or fail_pause

    case worktree
        # 既存 branch (local/remote、更新順) を選ぶか、新規 branch を作るかを選択する。
        # 既存 branch への --create は「already exists」で失敗するため、選択結果で出し分ける。
        set -l branches (git -C $repo_path for-each-ref --format='%(refname:short)' \
            --sort=-committerdate refs/heads refs/remotes/origin \
            | string replace -r '^origin/' '' | grep -vx origin | awk '!seen[$0]++')
        set -l new_label '+ create new branch'
        set -l choice (printf '%s\n' $new_label $branches | fzf --prompt='branch> ')
        test -n "$choice"; or exit 0
        set -l create_flag
        set -l branch $choice
        if test "$choice" = "$new_label"
            # read -l だと if ブロックローカルになり外側の branch を隠すので付けない。
            read -P 'new branch> ' branch; or exit 0
            test -n "$branch"; or exit 0
            set create_flag --create
        end
        # -x echo で worktree パスだけを stdout から受け取る (進捗表示は stderr)。
        set -l wt_path (wt -C $repo_path switch $create_flag $branch --no-cd -x echo -- '{{ worktree_path }}')
        or fail_pause
        set created (herdr worktree open --cwd $repo_path --path $wt_path --label $branch --focus --json)
        or fail_pause

    case pr-review
        cd $repo_path # gh はカレントディレクトリのリポジトリを対象にする
        # 自分宛てにレビュー依頼された PR を優先表示し、0 件なら全 open PR に
        # フォールバックする (どちらのモードかは fzf のプロンプトで分かる)。
        # レビュー範囲は「PR の base 〜 PR ブランチの HEAD」なので、デフォルトブランチ
        # ではなく PR ごとの baseRefName を取得して diff の基準に使う
        # (stacked PR では base がデフォルトブランチと一致しない)。
        set -l pr_jq '.[] | "\(.number)\t\(.title)\t\(.author.login)\t\(.baseRefName)"'
        set -l pr_prompt 'pr (review-requested)> '
        set -l pr_lines (gh pr list --limit 50 --search 'review-requested:@me' \
            --json number,title,author,baseRefName --jq $pr_jq)
        if test -z "$pr_lines"
            set pr_prompt 'pr (all)> '
            set pr_lines (gh pr list --limit 50 --json number,title,author,baseRefName --jq $pr_jq)
        end
        set -l pr_line (printf '%s\n' $pr_lines | fzf --prompt=$pr_prompt)
        test -n "$pr_line"; or exit 0
        set -l pr_fields (string split \t -- $pr_line)
        set -l pr_number $pr_fields[1]
        set -l pr_title $pr_fields[2]
        set base_branch $pr_fields[4]

        # PR ブランチの worktree を worktrunk で作成する。fork PR は refs/pull/N/head
        # を fetch し pushRemote を fork に向けてくれる。再実行時は既存 worktree を
        # 使い回すが、PR ブランチは fetch されないので最新化は手動で行う。
        set -l wt_path (wt -C $repo_path switch pr:$pr_number --no-cd -x echo -- '{{ worktree_path }}')
        or fail_pause
        git -C $wt_path fetch origin $base_branch
        # label は `👀<PR タイトル>`。👀 がレビュー用 workspace の目印。
        # sidebar (spaces) の workspace 行は実効 47 カラムしかなく、全角は 1 文字
        # 2 カラム消費するため、PR 番号やチケット番号に幅を割くとタイトル本体が
        # 見切れて識別できない (`pr-<番号>` で識別できなかったのが元の問題)。
        # 幅を食うだけで識別に効かない要素を落としてからタイトルを渡す:
        #   - 末尾の [SGN-FY26-1203] 形式のチケット番号は除去
        #   - 先頭の 【HR】【動作確認用】 のような角括弧タグ群は最初の 1 つだけを
        #     半角化して残す (プロダクト区分は識別に効くが全角の括弧は高い)
        # 溢れた分は herdr の sidebar が unicode 幅ベースで切り詰める。
        set -l label_title (string replace -ra '\s*\[[A-Z]+-[A-Z0-9]+-\d+\]' '' -- $pr_title \
            | string replace -r '^【([^】]*)】(?:【[^】]*】)*\s*' '$1 ')
        set created (herdr worktree open --cwd $repo_path --path $wt_path \
            --label "👀$label_title" --focus --json)
        or fail_pause
end

# --- workspace / 初期タブ / 初期ペインを JSON レスポンスから解決 ---
set -l ws (echo $created | jq -r '.result.workspace.workspace_id')
set -l agent_tab (echo $created | jq -r '.result.tab.tab_id')
set -l agent_pane (echo $created | jq -r '.result.root_pane.pane_id')
set -l work_path (echo $created | jq -r '.result.root_pane.cwd')

# --- 共通レイアウト: agent タブ (claude) + editor タブ (nvim) ---
herdr tab rename $agent_tab agent

set -l editor (herdr tab create --workspace $ws --cwd $work_path --label editor --no-focus)
herdr pane run (echo $editor | jq -r '.result.root_pane.pane_id') nvim

# --- pr-review: PR の base との diff を hunk で開く review タブ ---
if test $mode = pr-review
    set -l review (herdr tab create --workspace $ws --cwd $work_path --label review --no-focus)
    # hunk diff <ref> は working tree と <ref> の直接比較。base ブランチ側の
    # 先行コミットを差分に混ぜないよう merge-base を基準にする。
    set -l diff_base (git -C $work_path merge-base origin/$base_branch HEAD)
    herdr pane run (echo $review | jq -r '.result.root_pane.pane_id') "hunk diff $diff_base"
end

herdr tab focus $agent_tab

# --- claude を名前付きエージェントとして起動 (0.7.5 の agent start) ---
# pane run と違い agent 検出・入力可能になるまでブロックするので、
# レイアウト構築を済ませた最後に実行する。名前を付けておくと以後
# `herdr agent prompt/wait/read <name>` で操作できる。
# 名前は live agent 間で一意である必要があるため workspace id を添える。
# バリデーション: 英小文字始まり、[a-z0-9_-] のみ、1-32 文字。
# workspace id は大文字を含む (wF 等) ので小文字化が必須。
set -l agent_name (string lower -- "$repo_name-$ws" | string replace -ra '[^a-z0-9_-]' '-' | string replace -r '^[^a-z]+' '' | string sub -l 32)
test -n "$agent_name"; or set agent_name claude
# `--` 以降は AGENT_ARG として claude にそのまま渡るため、herdr 自身のオプションは
# すべて `--` より前に置く (後ろに回ると claude が unknown option で即死する)。
set -l agent_prompt # `--` を含む。pr-review 以外は空配列のまま展開されない
if test $mode = pr-review
    # /code-review の引数は「空白を含まない 1 トークン」にする。空白を含む引数
    # (以前の `xhigh <branch>`) は ref ではなく findings 向けのメモとして解釈され、
    # 比較対象が暗黙にリポジトリのデフォルトブランチへ落ちてしまう。
    # base 名だけを渡す形も駄目で (デフォルトブランチとの diff になった)、
    # `<base>..<head>` と両端を明示する。base は fetch 済みの remote-tracking ref を
    # 確実に指すよう origin/ 付き、head は worktree の現在ブランチ名を使う
    # (fork PR では wt が付けるブランチ名が PR の headRefName と一致しないため)。
    # effort は /code-review の引数では指定できないので claude の CLI フラグで渡す。
    # detached の場合は "HEAD" が返り、それがそのまま ref として使える。
    set -l head_ref (git -C $work_path rev-parse --abbrev-ref HEAD)
    set agent_prompt -- --effort xhigh "/code-review origin/$base_branch..$head_ref"
end
# shell の初期化が済むまで herdr 0.7.5 の agent start は agent_pane_busy で即時失敗する
# (内部リトライなし)。大きなリポジトリでは worktree 作成や wt hook の負荷で shell の
# 準備に数秒かかることがあるため、busy の間は最大 30 秒リトライで待つ。
# claude 側の起動検出も重いリポジトリでは 30 秒 (デフォルト) を超え得るので延長する。
set -l started false
for _retry in (seq 60)
    set -l err (herdr agent start $agent_name --kind claude --pane $agent_pane \
        --timeout 120000 $agent_prompt 2>&1)
    if test $status -eq 0
        set started true
        break
    end
    # busy 以外のエラー (名前衝突など) はリトライしても解決しない
    if not string match -qr 'busy|available shell' -- "$err"
        echo $err >&2
        fail_pause
    end
    sleep 0.5
end
if test $started != true
    echo 'herdr agent start: retry exhausted (pane busy)' >&2
    fail_pause
end

# --- プロジェクト固有セットアップ (規約ファイル) ---
if test -x $work_path/.herdr-setup.fish
    env HERDR_LAUNCH_WORKSPACE_ID=$ws HERDR_LAUNCH_MODE=$mode \
        fish -c "cd $work_path; and ./.herdr-setup.fish"
end
